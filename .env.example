# Reference only: programs read process environment; no implicit .env loading.
# Never commit real resource identifiers, secrets, or populated environment files.
# Passwordless remains the cloud default. Writes are disabled until explicitly approved.
MONGO_AUTH_MODE=oidc
MONGO_CLUSTER_NAME=<your-approved-cluster-name>
# MONGO_HOST=<your-cluster>.global.mongocluster.cosmos.azure.com
# MONGO_OIDC_USERNAME=<optional-client-id>
# Native alternative: set MONGO_AUTH_MODE=connection-string, inject URI securely.
# MONGO_CONNECTION_STRING=<secret-mongodb+srv-uri-without-database-path>
MONGO_DATABASE=vectorsearch_disposable_my_run
MONGO_COLLECTION_PREFIX=hotels
# MONGO_COLLECTION=<single-command-override>
VECTOR_SEARCH_ALLOW_WRITES=false
VECTOR_SEARCH_TIMEOUT=5m
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
SEED_ID_FIELD=HotelId
EMBEDDED_FIELD=DescriptionVector
EMBEDDING_DIMENSIONS=1536
LOAD_SIZE_BATCH=100
TOP_K=5

# Default model mode needs an actual compatible deployment and model permission.
EMBEDDING_MODE=azure-openai
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_MODEL=<your-embedding-deployment-name>
# AZURE_OPENAI_EMBEDDING_KEY=<optional-secret-key-otherwise-Entra>
QUERY_TEXT=quintessential lodging near running trails, eateries, retail

# No-model alternative: change EMBEDDING_MODE=offline and set this numeric-array file.
# Generate it locally with go run ./cmd/query-vector (no cloud calls).
# QUERY_VECTOR_FILE=data/query-vector.json

# Optional billable embedding generation (no MongoDB dependency):
ALLOW_EMBEDDING_GENERATION=false
DATA_FILE_WITHOUT_VECTORS=data/Hotels.json
FIELD_TO_EMBED=Description
EMBEDDING_SIZE_BATCH=16

# Live integration requires an explicit separate opt-in and absolute data paths:
# VECTOR_SEARCH_LIVE_TEST=1
